{
  "globals": {
    "ga": true,
    "chrome": true
  },
  "plugins": ["html", "json"],
  "extends": "eslint:recommended",
  "rules": {
    "no-restricted-globals": ["error", "event", "fdescribe"],
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_" }]
  },
  "parserOptions": {
    "ecmaVersion": 2020,
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "env": {
    "browser": true,
    "node": true,
    "es6": true
  }
}
